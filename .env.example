# PRAHARI Environment Configuration Template
# Copy this file to .env or .env.local for local testing.
# NEVER commit .env or secret keys to GitHub or version control!

# Optional Gemini API Key for server-side AI expansions
GEMINI_API_KEY=

# Hugging Face API Secret Key for Whisper Large-v3 Speech-to-Text
# (Server-only secret; never exposed to the frontend)
HUGGINGFACE_API_KEY=

# Optional Supabase Database Configuration
# (If omitted, PRAHARI automatically uses its persistent backend database store)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional Firebase Project Configuration
# If left empty, PRAHARI runs in full-featured resilient local store mode
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
